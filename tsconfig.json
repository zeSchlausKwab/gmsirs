{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@monorepo/common/*": ["packages/common/src/*"],
      "@monorepo/common": ["packages/common/src"],
      "@monorepo/db/*": ["packages/db/src/*"],
      "@monorepo/db": ["packages/db/src"]
    }
  }
} 